digraph logico {
	bgcolor=white nodesep=0.55 pad=0.2 rankdir=LR ranksep=0.9 splines=polyline
	graph [fontname=Arial fontsize=22 label="Modelo logico ampliado" labelloc=t]
	node [fontname=Arial fontsize=9 shape=plain]
	edge [arrowsize=0.7 color=black fontname=Arial fontsize=8]
	usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>USUARIOS</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_usuario</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">apellido</TD></TR><TR><TD ALIGN="LEFT">fecha_registro</TD></TR><TR><TD ALIGN="LEFT">activo</TD></TR></TABLE>>]
	telefonos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>USUARIO_TELEFONOS</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> id_usuario -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> telefono</TD></TR></TABLE>>]
	emails [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>USUARIO_EMAILS</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> id_usuario -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> email</TD></TR></TABLE>>]
	categorias [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>CATEGORIAS</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_categoria</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_categoria_padre -&gt; CATEGORIAS.id_categoria</TD></TR></TABLE>>]
	ubicaciones [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>UBICACIONES [NUEVA]</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_ubicacion</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">direccion</TD></TR><TR><TD ALIGN="LEFT">ciudad</TD></TR><TR><TD ALIGN="LEFT">capacidad</TD></TR></TABLE>>]
	eventos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>EVENTOS [AMPLIADA]</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_evento</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_usuario_propietario -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_categoria -&gt; CATEGORIAS.id_categoria</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_ubicacion -&gt; UBICACIONES.id_ubicacion</TD></TR><TR><TD ALIGN="LEFT">titulo</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">fecha_inicio</TD></TR><TR><TD ALIGN="LEFT">fecha_fin</TD></TR></TABLE>>]
	part [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>PARTICIPACIONES</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> id_evento -&gt; EVENTOS.id_evento</TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> id_invitado -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT">rol</TD></TR><TR><TD ALIGN="LEFT">estado_confirmacion</TD></TR></TABLE>>]
	log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>LOG_ACCESOS</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_log</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_usuario -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT">fecha_acceso</TD></TR></TABLE>>]
	tipos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>TIPOS_DISPONIBILIDAD [NUEVA]</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_tipo_disponibilidad</TD></TR><TR><TD ALIGN="LEFT"><B>UNIQUE</B> nombre</TD></TR></TABLE>>]
	disp [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>DISPONIBILIDADES [NUEVA]</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_disponibilidad</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_usuario -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT">fecha</TD></TR><TR><TD ALIGN="LEFT">hora_inicio</TD></TR><TR><TD ALIGN="LEFT">hora_fin</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_tipo_disponibilidad -&gt; TIPOS_DISPONIBILIDAD.id_tipo_disponibilidad</TD></TR></TABLE>>]
	tareas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
    <TR><TD BGCOLOR="#DDDDDD"><B>TAREAS [NUEVA]</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id_tarea</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_evento -&gt; EVENTOS.id_evento</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> id_usuario_responsable -&gt; USUARIOS.id_usuario</TD></TR><TR><TD ALIGN="LEFT">titulo</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">prioridad</TD></TR><TR><TD ALIGN="LEFT">fecha_limite</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>]
	telefonos -> usuarios [label=id_usuario]
	emails -> usuarios [label=id_usuario]
	categorias -> categorias [label=id_categoria_padre]
	eventos -> usuarios [label=propietario]
	eventos -> categorias [label=categoria]
	eventos -> ubicaciones [label=ubicacion]
	part -> eventos [label=id_evento]
	part -> usuarios [label=id_invitado]
	log -> usuarios [label=id_usuario]
	disp -> usuarios [label=id_usuario]
	disp -> tipos [label=tipo]
	tareas -> eventos [label=id_evento]
	tareas -> usuarios [label=responsable]
}
