	R_PERT [label=PERTENECE fontsize=9 margin=0.08 shape=diamond]
	R_PART [label=PARTICIPACION fontsize=9 margin=0.08 shape=diamond]
	R_JER [label=JERARQUIA fontsize=9 margin=0.08 shape=diamond]
	R_REG [label=REGISTRA fontsize=9 margin=0.08 shape=diamond]
	R_UBI [label="SE REALIZA EN" fontsize=9 margin=0.08 shape=diamond]
	R_DISP [label=TIENE fontsize=9 margin=0.08 shape=diamond]
	R_TIPO [label=CLASIFICA fontsize=9 margin=0.08 shape=diamond]
