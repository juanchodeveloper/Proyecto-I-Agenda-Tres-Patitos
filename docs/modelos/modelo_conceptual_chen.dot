	EVENTOS -> e_fin
	l_id [label=<<U>id_log</U>> fontsize=9 peripheries=1 shape=ellipse]
	l_fecha [label=fecha_acceso fontsize=9 peripheries=1 shape=ellipse]
	LOG_ACCESOS -> l_id
	LOG_ACCESOS -> l_fecha
	ub_id [label=<<U>id_ubicacion</U>> fontsize=9 peripheries=1 shape=ellipse]
	ub_nom [label=nombre fontsize=9 peripheries=1 shape=ellipse]
	ub_dir [label=direccion fontsize=9 peripheries=1 shape=ellipse]
	ub_ciu [label=ciudad fontsize=9 peripheries=1 shape=ellipse]
	ub_cap [label=capacidad fontsize=9 peripheries=1 shape=ellipse]
	UBICACIONES -> ub_id
	UBICACIONES -> ub_nom
	UBICACIONES -> ub_dir
	UBICACIONES -> ub_ciu
	UBICACIONES -> ub_cap
