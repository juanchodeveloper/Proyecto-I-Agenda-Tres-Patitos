digraph conceptual {
	bgcolor=white nodesep=0.45 overlap=false pad=0.25 rankdir=LR ranksep=1.1 splines=spline
	graph [fontname=Arial fontsize=22 label="Modelo conceptual ampliado - Notacion de Chen" labelloc=t]
	node [color=black fontname=Arial fontsize=10 style=solid]
	edge [color=black dir=none fontname=Arial fontsize=9]
	USUARIOS [label=USUARIOS fontsize=11 shape=box]
	CATEGORIAS [label=CATEGORIAS fontsize=11 shape=box]
	EVENTOS [label=EVENTOS fontsize=11 shape=box]
