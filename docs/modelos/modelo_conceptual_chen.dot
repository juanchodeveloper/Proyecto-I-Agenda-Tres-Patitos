	TAREAS [label=TAREAS fontsize=11 shape=box]
	u_id [label=<<U>id_usuario</U>> fontsize=9 peripheries=1 shape=ellipse]
	u_nombre [label=nombre fontsize=9 peripheries=1 shape=ellipse]
	u_apellido [label=apellido fontsize=9 peripheries=1 shape=ellipse]
	u_fecha [label=fecha_registro fontsize=9 peripheries=1 shape=ellipse]
	u_activo [label=activo fontsize=9 peripheries=1 shape=ellipse]
	u_tel [label=telefonos fontsize=9 peripheries=2 shape=ellipse]
	u_email [label=emails fontsize=9 peripheries=2 shape=ellipse]
	USUARIOS -> u_id
	USUARIOS -> u_nombre
	USUARIOS -> u_apellido
	USUARIOS -> u_fecha
	USUARIOS -> u_activo
	USUARIOS -> u_tel
	USUARIOS -> u_email
	c_id [label=<<U>id_categoria</U>> fontsize=9 peripheries=1 shape=ellipse]
	c_nombre [label=nombre fontsize=9 peripheries=1 shape=ellipse]
	CATEGORIAS -> c_id
	CATEGORIAS -> c_nombre
	e_id [label=<<U>id_evento</U>> fontsize=9 peripheries=1 shape=ellipse]
	e_titulo [label=titulo fontsize=9 peripheries=1 shape=ellipse]
	e_desc [label=descripcion fontsize=9 peripheries=1 shape=ellipse]
	e_ini [label=fecha_inicio fontsize=9 peripheries=1 shape=ellipse]
	e_fin [label=fecha_fin fontsize=9 peripheries=1 shape=ellipse]
